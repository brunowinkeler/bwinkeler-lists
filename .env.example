# Development configuration. This file contains names and placeholders only.
# Never put real secrets here or in Git.

# Backend runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
PUBLIC_ORIGIN=http://localhost:5173

# PostgreSQL (local development)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=lists_dev
PGUSER=lists_dev
PGPASSWORD=change-me-in-dev

# Sessions and CSRF
SESSION_COOKIE_NAME=lists_sid
CSRF_COOKIE_NAME=lists_csrf
SESSION_TTL_HOURS=168
SESSION_SECRET=change-me-in-dev
RATE_LIMIT_MAX=1000

# Logging
LOG_LEVEL=info

# Frontend (Vite) — public, non-secret
VITE_API_BASE=/api
